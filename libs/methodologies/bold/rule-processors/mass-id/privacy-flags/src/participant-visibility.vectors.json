{
  "$comment": [
    "Conformance vectors for participant visibility resolution.",
    "Canonical rule: participant-visibility.spec.md beside this file.",
    "Vendored byte-identical into palantir, smaug, methodology-rules and rivendell.",
    "Each repo runs these through ITS OWN resolver. Do not copy a reference implementation.",
    "",
    "Each vector describes ONE participant across ONE whole document. `occurrences` are every",
    "place that participant id appears; `preserveSensitiveData` is omitted when the source data",
    "omits it, which is a distinct case from false and is where implementations diverge.",
    "",
    "`decidedBy` names the spec step that decides, so a failure points at the rule, not just at",
    "a boolean. It is documentation for the person reading the failure, not an assertion.",
    "",
    "An occurrence with no `role` is an ACTOR event with no `label`. `legacyActorType` is that",
    "event's legacy `actor-type` metadata attribute, value and own `isPublic` as the source data",
    "carries them. See \"Where the role comes from\" in the spec."
  ],
  "version": "1.2.0",
  "roles": {
    "public": [
      "Processor",
      "Recycler",
      "Network Integrator"
    ],
    "private": [
      "Waste Generator",
      "Hauler",
      "Bin Custodian",
      "Waste Manager"
    ]
  },
  "vectors": [
    {
      "id": "explicit-true-beats-public-role-default",
      "decidedBy": 1,
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Recycler",
          "preserveSensitiveData": true
        }
      ],
      "expected": "private"
    },
    {
      "id": "explicit-true-on-one-of-several-occurrences-propagates",
      "decidedBy": 1,
      "note": "Most-private-wins across the document. A last-write-wins map resolves this public and is wrong.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Recycler"
        },
        {
          "role": "Recycler",
          "preserveSensitiveData": true
        }
      ],
      "expected": "private"
    },
    {
      "id": "explicit-true-beats-explicit-false-elsewhere",
      "decidedBy": 1,
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Recycler",
          "preserveSensitiveData": false
        },
        {
          "role": "Hauler",
          "preserveSensitiveData": true
        }
      ],
      "expected": "private"
    },
    {
      "id": "explicit-true-beats-hauler-plus-recycler-exception",
      "decidedBy": 1,
      "note": "Step 3 applies only when no occurrence asks for privacy.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Hauler",
          "preserveSensitiveData": true
        },
        {
          "role": "Recycler"
        }
      ],
      "expected": "private"
    },
    {
      "id": "explicit-true-beats-network-integrator-default",
      "decidedBy": 1,
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Network Integrator",
          "preserveSensitiveData": true
        }
      ],
      "expected": "private"
    },
    {
      "id": "waste-generator-default-private",
      "decidedBy": 2,
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Waste Generator"
        }
      ],
      "expected": "private"
    },
    {
      "id": "waste-generator-explicit-false-is-still-private",
      "decidedBy": 2,
      "note": "The asymmetry with Hauler. Step 2 is terminal, so step 4 is never reached for a generator.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Waste Generator",
          "preserveSensitiveData": false
        }
      ],
      "expected": "private"
    },
    {
      "id": "waste-generator-with-recycler-is-private",
      "decidedBy": 2,
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Waste Generator"
        },
        {
          "role": "Recycler"
        }
      ],
      "expected": "private"
    },
    {
      "id": "waste-generator-blocks-the-hauler-plus-recycler-exception",
      "decidedBy": 2,
      "note": "Holds Hauler and Recycler, which alone would be public, but the generator role overrides.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Waste Generator"
        },
        {
          "role": "Hauler"
        },
        {
          "role": "Recycler"
        }
      ],
      "expected": "private"
    },
    {
      "id": "unlabeled-legacy-waste-generator-explicit-false-is-private",
      "decidedBy": 2,
      "note": "Legacy MassIDs carry the role in `actor-type`, not `label`. A resolver that reads only `label` sees no role and publishes this generator at step 4.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "legacyActorType": {
            "value": "SOURCE",
            "isPublic": true
          },
          "preserveSensitiveData": false
        }
      ],
      "expected": "private"
    },
    {
      "id": "unlabeled-legacy-waste-generator-with-private-attribute-and-field-absent-is-private",
      "decidedBy": 2,
      "note": "The attribute's own `isPublic` governs publishing the attribute, not reading the role. Skipping private attributes falls through to the COMPANY default at step 5.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "legacyActorType": {
            "value": "SOURCE",
            "isPublic": false
          }
        }
      ],
      "expected": "private"
    },
    {
      "id": "label-and-legacy-actor-type-on-one-event-hold-both-roles",
      "decidedBy": 2,
      "note": "The label does not override `actor-type`. A resolver that reads `actor-type` only when `label` is missing publishes this generator as a Recycler.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Recycler",
          "legacyActorType": {
            "value": "SOURCE",
            "isPublic": true
          }
        }
      ],
      "expected": "private"
    },
    {
      "id": "hauler-with-recycler-is-public",
      "decidedBy": 3,
      "note": "No flag anywhere. Role defaults alone would resolve private (Hauler); the exception overrides.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Hauler"
        },
        {
          "role": "Recycler"
        }
      ],
      "expected": "public"
    },
    {
      "id": "hauler-with-processor-is-public",
      "decidedBy": 3,
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Hauler"
        },
        {
          "role": "Processor"
        }
      ],
      "expected": "public"
    },
    {
      "id": "hauler-explicit-false-is-public",
      "decidedBy": 4,
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Hauler",
          "preserveSensitiveData": false
        }
      ],
      "expected": "public"
    },
    {
      "id": "bin-custodian-explicit-false-is-public",
      "decidedBy": 4,
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Bin Custodian",
          "preserveSensitiveData": false
        }
      ],
      "expected": "public"
    },
    {
      "id": "explicit-false-beats-the-individual-type-fallback",
      "decidedBy": 4,
      "participantType": "INDIVIDUAL",
      "occurrences": [
        {
          "role": "Bin Custodian",
          "preserveSensitiveData": false
        }
      ],
      "expected": "public"
    },
    {
      "id": "recycler-with-field-absent-is-public",
      "decidedBy": 5,
      "note": "The absent-field case. An implementation that treats absence as withhold fails here.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Recycler"
        }
      ],
      "expected": "public"
    },
    {
      "id": "processor-with-field-absent-is-public",
      "decidedBy": 5,
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Processor"
        }
      ],
      "expected": "public"
    },
    {
      "id": "network-integrator-with-field-absent-is-public",
      "decidedBy": 5,
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Network Integrator"
        }
      ],
      "expected": "public"
    },
    {
      "id": "unlabeled-legacy-network-integrator-individual-is-public",
      "decidedBy": 5,
      "note": "`INTEGRATOR` names Network Integrator, whose default beats the individual type fallback. A resolver that drops the mapping resolves this private.",
      "participantType": "INDIVIDUAL",
      "occurrences": [
        {
          "legacyActorType": {
            "value": "INTEGRATOR",
            "isPublic": true
          }
        }
      ],
      "expected": "public"
    },
    {
      "id": "waste-manager-with-field-absent-is-private",
      "decidedBy": 5,
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Waste Manager"
        }
      ],
      "expected": "private",
      "note": "Private to stop re-identification of the generator it is contracted by, not because its own role is sensitive."
    },
    {
      "id": "hauler-with-field-absent-is-private",
      "decidedBy": 5,
      "note": "The mirror of the recycler case. An implementation that treats absence as publish fails here.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Hauler"
        }
      ],
      "expected": "private"
    },
    {
      "id": "unlabeled-legacy-hauler-with-field-absent-is-private",
      "decidedBy": 5,
      "note": "A label-only resolver sees no role and publishes this COMPANY hauler at step 5.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "legacyActorType": {
            "value": "HAULER",
            "isPublic": true
          }
        }
      ],
      "expected": "private"
    },
    {
      "id": "bin-custodian-with-field-absent-is-private",
      "decidedBy": 5,
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Bin Custodian"
        }
      ],
      "expected": "private"
    },
    {
      "id": "disagreeing-role-defaults-resolve-private",
      "decidedBy": 5,
      "note": "Network Integrator is public and Hauler is private, and this pair is not the step 3 exception.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Hauler"
        },
        {
          "role": "Network Integrator"
        }
      ],
      "expected": "private"
    },
    {
      "id": "unknown-role-company-is-public",
      "decidedBy": 5,
      "note": "Type fallback, reached only when no role is one of the seven.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "role": "Auditor"
        }
      ],
      "expected": "public"
    },
    {
      "id": "unknown-role-individual-is-private",
      "decidedBy": 5,
      "participantType": "INDIVIDUAL",
      "occurrences": [
        {
          "role": "Auditor"
        }
      ],
      "expected": "private"
    },
    {
      "id": "unknown-legacy-actor-type-company-is-public",
      "decidedBy": 5,
      "note": "Only the five mapped `actor-type` values name a role; any other falls to the participant type.",
      "participantType": "COMPANY",
      "occurrences": [
        {
          "legacyActorType": {
            "value": "AUDITOR",
            "isPublic": true
          }
        }
      ],
      "expected": "public"
    }
  ]
}
